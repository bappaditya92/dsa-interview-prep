import java.util.*;

class LFUCache {
    private final int capacity;
    private Map<Integer, Integer> values = new HashMap<>();
    private Map<Integer, Integer> counts = new HashMap<>();
    private Map<Integer, LinkedHashSet<Integer>> freqMap = new HashMap<>();
    private int min = -1;

    public LFUCache(int capacity) {
        this.capacity = capacity;
    }

    public int get(int key) {
        if (!values.containsKey(key)) return -1;

        int count = counts.get(key);
        counts.put(key, count + 1);

        freqMap.get(count).remove(key);
        if (count == min && freqMap.get(count).isEmpty()) {
            min++;
        }

        freqMap.computeIfAbsent(count + 1, k -> new LinkedHashSet<>()).add(key);
        return values.get(key);
    }

    public void put(int key, int value) {
        if (capacity <= 0) return;

        if (values.containsKey(key)) {
            values.put(key, value);
            get(key);
            return;
        }

        if (values.size() >= capacity) {
            int evict = freqMap.get(min).iterator().next();
            freqMap.get(min).remove(evict);
            values.remove(evict);
            counts.remove(evict);
        }

        values.put(key, value);
        counts.put(key, 1);
        min = 1;
        freqMap.computeIfAbsent(1, k -> new LinkedHashSet<>()).add(key);
    }
              }
